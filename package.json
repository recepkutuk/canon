{
  "name": "canon-ui",
  "version": "0.2.0",
  "description": "Component library for internal tools and admin screens: tables, forms, records, in accessible plain HTML. No build step; works with any server (Django, Rails, Laravel, Go, htmx).",
  "keywords": [
    "accessibility",
    "components",
    "css",
    "design-system",
    "html",
    "internal-tools",
    "admin-panel",
    "themes",
    "htmx",
    "django",
    "rails",
    "laravel",
    "server-rendered",
    "no-build"
  ],
  "license": "MIT",
  "author": "Recep Kütük",
  "homepage": "https://recepkutuk.github.io/canon/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recepkutuk/canon.git"
  },
  "bin": {
    "canon-ui": "tools/cli.mjs"
  },
  "files": [
    "css",
    "docs/markup-rules.md",
    "!css/canon.debug.css",
    "i18n",
    "js/canon.js",
    "licenses",
    "src",
    "THIRD-PARTY-NOTICES.md",
    "tools",
    "!tools/site.mjs"
  ],
  "exports": {
    ".": "./js/canon.js",
    "./css/*": "./css/*",
    "./i18n/*": "./i18n/*",
    "./js/*": "./js/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "node tools/build.mjs"
  }
}
